---
import { getImage, Image } from "astro:assets";
import portrait from "../assets/portrait.webp";
import celebrantIcon from "../assets/work/celebrant-icon.png";
import chatIconDark from "../assets/work/chat-icon-dark.png";
import chatIconLight from "../assets/work/chat-icon-light.png";
import datameterIcon from "../assets/work/datameter-icon.png";
import groqIcon from "../assets/work/groqdictate-icon.png";
import vendorsIcon from "../assets/work/vendors-icon.png";
import Page from "../layouts/page.astro";
import { contact, earlier, intro, next, work } from "../site";

const iconSize = { width: 56, height: 56, densities: [1, 2], format: "webp" } as const;
const chatIcon = {
  light: await getImage({ src: chatIconLight, ...iconSize }),
  dark: await getImage({ src: chatIconDark, ...iconSize }),
};
const [chat, celebrant, groq, datameter] = work;
---

<Page title="Emmanuel Chucks" description="Emmanuel Chucks, software engineer in Accra: product software across mobile, backend, AI, and devtools.">
  <main class="page">
    <header class="intro">
      <Image src={portrait} alt="Emmanuel Chucks" width={64} height={64} densities={[1, 2]} class="face" />
      <h1>{intro.name}</h1>
      <p class="line">{intro.line}</p>
      <ul class="contact">
        {contact.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
        <li class="place">{intro.place}</li>
      </ul>
      <p class="open">Taking on new work.</p>
    </header>

    <ol class="work" aria-label="Work">
      <li>
        <picture class="icon casts">
          <source media="(prefers-color-scheme: dark)" srcset={chatIcon.dark.srcSet.attribute} />
          <img src={chatIcon.light.src} srcset={chatIcon.light.srcSet.attribute} width="56" height="56" alt="" />
        </picture>
        <div>
          <h2><a href="/work/staff-chat">{chat.title}</a></h2>
          <p>{chat.text}</p>
          <p class="kind">{chat.kind}</p>
        </div>
      </li>
      <li>
        <span class="icon pair">
          <Image src={vendorsIcon} alt="" {...iconSize} class="casts" />
          <Image src={celebrantIcon} alt="" {...iconSize} class="casts" />
        </span>
        <div>
          <h2><a href="/work/celebrant-and-vendors">{celebrant.title}</a></h2>
          <p>{celebrant.text}</p>
          <p class="kind">{celebrant.kind}</p>
        </div>
      </li>
      <li>
        <Image src={groqIcon} alt="" width={70} height={70} densities={[1, 2]} class="icon mac casts" />
        <div>
          <h2><a href="/work/groqdictate">{groq.title}</a></h2>
          <p>{groq.text}</p>
          <p class="kind">{groq.kind}</p>
        </div>
      </li>
      <li>
        <Image src={datameterIcon} alt="" width={70} height={70} densities={[1, 2]} class="icon mac casts" />
        <div>
          <h2><a href="/work/datameter">{datameter.title}</a></h2>
          <p>{datameter.text}</p>
          <p class="kind">{datameter.kind}</p>
        </div>
      </li>
      <li class="next">
        <span class="icon ghost" aria-hidden="true"></span>
        <div>
          <h2>Building next</h2>
          <p>{next}</p>
        </div>
      </li>
    </ol>

    <section class="more">
      <h2>Earlier</h2>
      <p>{earlier.map((e, i) => <>{i > 0 && ", "}<a href={e.href}>{e.title}</a></>)}</p>
    </section>
  </main>

</Page>

<style is:global>
  .page { position: relative; z-index: 1; width: min(100% - 48px, 600px); margin: 0 auto; padding: 18vh 0 120px; }

  .intro { display: grid; grid-template-columns: 1fr auto; column-gap: 32px; align-items: center; }
  .face { grid-column: 2; grid-row: 1 / span 2; width: 64px; height: 64px; border-radius: 50%; }
  .intro h1 { font-size: 40px; font-weight: 700; letter-spacing: -0.03em; line-height: 1; font-variation-settings: "opsz" 96; }
  .line { margin-top: 8px; color: var(--muted); font-size: 17px; }
  .contact { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 6px 22px; margin-top: 24px; font-weight: 600; }
  .place { color: var(--muted); font-weight: 400; }
  .open { grid-column: 1 / -1; margin-top: 10px; color: var(--muted); font-size: 15px; }

  /* The work, each led by its app icon. The icons are the page's only colour. */
  .work { margin-top: 88px; display: grid; gap: 36px; }
  .work li { display: grid; grid-template-columns: 76px 1fr; column-gap: 20px; align-items: start; }
  .work h2 { font-size: 20px; font-weight: 650; letter-spacing: -0.02em; line-height: 1.2; }
  .work h2 a { text-decoration-color: color-mix(in srgb, currentColor 30%, transparent); }
  .work p { margin-top: 4px; color: var(--text); max-width: 44ch; }
  .work .kind { margin-top: 8px; color: var(--muted); font-size: 13px; }

  .icon { position: relative; display: block; width: 56px; height: 56px; }
  .icon img { display: block; width: 56px; height: 56px; }
  picture.icon img { border-radius: 22.5%; }
  .pair img { position: absolute; width: 40px; height: 40px; }
  .pair img:first-child { left: 18px; top: 18px; }
  .pair img:last-child { left: 0; top: 0; }
  /* macOS icons carry their own margin and a baked-in shadow; draw them larger and add none. */
  .icon.mac { width: 70px; height: 70px; margin: -7px 0 0 -7px; filter: none; animation: none; }
  .ghost { border-radius: 22.5%; outline: 1.5px dashed light-dark(rgb(0 0 0 / 0.28), rgb(255 255 255 / 0.22)); outline-offset: -1.5px; }
  .next h2 { color: var(--muted); font-weight: 500; }

  .more { margin-top: 80px; display: grid; grid-template-columns: 96px 1fr; gap: 10px 20px; }
  .more h2 { font-size: 14px; font-weight: 400; color: var(--muted); padding-top: 1px; }

  @media (max-width: 520px) {
    .page { padding-top: 12vh; }
    .intro h1 { font-size: 34px; }
    .work li { grid-template-columns: 60px 1fr; column-gap: 16px; }
    .icon, .icon img { width: 48px; height: 48px; }
    .pair img { width: 34px; height: 34px; }
    .pair img:first-child { left: 14px; top: 14px; }
    .icon.mac { width: 60px; height: 60px; margin: -6px 0 0 -6px; }
    .more { grid-template-columns: 1fr; gap: 4px; }
    .more p { margin-bottom: 18px; }
  }
</style>
