---
import { getImage } from "astro:assets";
import chatIconDark from "../../assets/work/chat-icon-dark.png";
import chatIconLight from "../../assets/work/chat-icon-light.png";
import listDark from "../../assets/work/chat-list-dark.png";
import listLight from "../../assets/work/chat-list-light.png";
import threadDark from "../../assets/work/chat-thread-dark.png";
import threadLight from "../../assets/work/chat-thread-light.png";
import Page from "../../layouts/page.astro";
import { intro, work } from "../../site";

const iconSize = { width: 56, height: 56, densities: [1, 2], format: "webp" } as const;
const icon = {
  light: await getImage({ src: chatIconLight, ...iconSize }),
  dark: await getImage({ src: chatIconDark, ...iconSize }),
};
const [chat] = work;
const shot = { width: 280, densities: [1, 2], format: "webp", quality: 72 } as const;
// Each screen is shown in the reader's own mode.
const shots = await Promise.all(
  [
    { light: threadLight, dark: threadDark, alt: "A conversation in the Celedom Staff chat, with quoted replies and a reaction.", caption: "A thread, with replies and reactions." },
    { light: listLight, dark: listDark, alt: "The chat list, with Celedom Assistant among the chats.", caption: "The chat list, with the assistant among the chats." },
  ].map(async ({ light, dark, alt, caption }) => ({ alt, caption, light: await getImage({ src: light, ...shot }), dark: await getImage({ src: dark, ...shot }) })),
);
---

<Page title="Celedom staff chat · Emmanuel Chucks" description="Celedom's internal chat for its staff, with an assistant built in. Built by Emmanuel Chucks for iOS and Android.">
  <main class="page">
    <a class="back" href="/">{intro.name}</a>
    <header class="head">
      <picture class="icon casts">
        <source media="(prefers-color-scheme: dark)" srcset={icon.dark.srcSet.attribute} />
        <img src={icon.light.src} srcset={icon.light.srcSet.attribute} width="56" height="56" alt="" />
      </picture>
      <div>
        <h1>{chat.title}</h1>
        <p class="kind">{chat.kind}</p>
      </div>
    </header>
    <p class="text">{chat.text}</p>
  </main>

  <section class="shots" aria-label="Screens">
    {
      shots.map((s) => (
        <figure>
          <picture class="screen casts">
            <source media="(prefers-color-scheme: dark)" srcset={s.dark.srcSet.attribute} />
            <img src={s.light.src} srcset={s.light.srcSet.attribute} width={s.light.attributes.width} height={s.light.attributes.height} alt={s.alt} />
          </picture>
          <figcaption>{s.caption}</figcaption>
        </figure>
      ))
    }
  </section>

  <p class="note">Made-up people and test data.</p>
</Page>

<style is:global>
  /* Here the light falls on the screens too, so it sits above them and below the words. */
  .window { z-index: 1; }
  .page, .note { position: relative; z-index: 2; }
  .page { width: min(100% - 48px, 600px); margin: 0 auto; padding: 14vh 0 0; }

  .back { color: var(--muted); font-size: 15px; text-decoration: none; }
  .back::before { content: "← "; }
  .back:hover { color: var(--ink); }

  .head { display: flex; gap: 20px; align-items: center; margin-top: 48px; }
  .icon { display: block; width: 56px; height: 56px; flex: none; }
  .icon img { display: block; width: 56px; height: 56px; border-radius: 22.5%; }
  .head h1 { font-size: 34px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; font-variation-settings: "opsz" 96; }
  .kind { margin-top: 4px; color: var(--muted); font-size: 14px; }
  .text { margin-top: 24px; max-width: 44ch; font-size: 18px; }

  /* Screens stand on the wall like prints, at a phone's own proportions and corners. */
  .shots { display: flex; justify-content: center; gap: 48px; padding: 72px 24px 0; }
  .shots figure { flex: none; width: 280px; }
  .screen, .screen img { display: block; width: 100%; height: auto; }
  .screen img { border-radius: 40px; }
  figcaption { margin-top: 18px; color: var(--muted); font-size: 14px; }
  .note { width: min(100% - 48px, 600px); margin: 64px auto 0; padding-bottom: 120px; color: var(--muted); font-size: 13px; }

  @media (max-width: 680px) {
    .head h1 { font-size: 28px; }
    .shots { justify-content: flex-start; gap: 20px; padding: 56px 24px 24px; overflow-x: auto; scrollbar-width: none; scroll-snap-type: x mandatory; scroll-padding: 0 24px; }
    .shots figure { width: 72vw; scroll-snap-align: start; }
    .screen img { border-radius: 10.5vw; }
  }
</style>
