---
import { Image } from "astro:assets";
import icon from "../../assets/work/groqdictate-icon.png";
import Dictation from "../../components/dictation.astro";
import Project from "../../components/project.astro";
import { groqDictate } from "../../site";
---

<Project
  {...groqDictate}
  description="GroqDictate: press Right ⌘, speak, and the text lands where you were working, on macOS and iPhone. Built by Emmanuel Chucks."
  note="The panel is a real dictation, with the talking sped up; the sentence is what came back."
>
  <Image slot="icon" src={icon} alt="" width={70} height={70} densities={[1, 2]} class="icon mac" />
  <Dictation
    slot="demo"
    sentence="Can you find out why the build fails on Node 26 without changing any dependencies?"
    caption="Right ⌘, speak, Right ⌘ again. The text lands where the cursor was."
  />
</Project>
