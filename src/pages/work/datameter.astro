---
import { Image } from "astro:assets";
import dark from "../../assets/work/datameter-dark.png";
import icon from "../../assets/work/datameter-icon.png";
import light from "../../assets/work/datameter-light.png";
import menuDark from "../../assets/work/datameter-menu-dark.png";
import menuLight from "../../assets/work/datameter-menu-light.png";
import Project from "../../components/project.astro";
import { dataMeter } from "../../site";
---

<Project
  {...dataMeter}
  description="DataMeter shows how much network data each app on your Mac uses, kept locally. Built by Emmanuel Chucks."
  note="Made-up usage, drawn from DataMeter's own views."
  steps={[
    {
      title: "Every app's share",
      text: "Each app's downloads and uploads, today, this week or this month, read from macOS's own counters and kept on the Mac. Wi‑Fi, Ethernet and a phone over USB each keep their own totals.",
      screens: [{ light, dark, frame: "window", alt: "DataMeter's window: 5.3 GB used today on Wi-Fi, with each app's downloads, uploads and total, led by Xcode, Safari and Google Chrome. Range and network pickers sit above the table." }],
    },
    {
      title: "One click away",
      text: "The day's total and the apps that used the most sit in the menu bar. While it's open it refreshes every two seconds, so a download running in the background climbs the list in front of you.",
      screens: [
        {
          light: menuLight,
          dark: menuDark,
          frame: "menu",
          video: { light: "/work/datameter-menu-light", dark: "/work/datameter-menu-dark" },
          alt: "DataMeter's menu bar panel refreshing: today's total climbs from 5.24 GB to 5.44 GB as an App Store download passes FaceTime, Music and Google Chrome.",
        },
      ],
    },
  ]}
>
  <Image slot="icon" src={icon} alt="" width={70} height={70} densities={[1, 2]} class="icon mac" />
</Project>
