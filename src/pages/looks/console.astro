---
import Home from "../../looks/home.astro";
import font from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
---

<Home look="console" font={font}>
  <style slot="head" is:inline set:html={`@font-face{font-family:"JetBrains Mono";src:url(${font}) format("woff2");font-weight:100 800;font-display:swap}`} />
</Home>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: light-dark(#f1f1ec, #0e100f);
    --ink: light-dark(#1b1d1b, #d6dbd4);
    --muted: light-dark(#6c706a, #7f877e);
    --line: light-dark(#c9ccc3, #2b302c);
    --accent: light-dark(#2f6f3a, #8fd694);
    --frame: light-dark(#e6e7e0, #151816);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.9375rem;
    line-height: 1.65;
    background: var(--bg);
    color: var(--ink);
  }
  body { margin: 0; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  :focus-visible { outline: 1px solid var(--accent); outline-offset: 2px; }
  h1, h2, h3, p, ol, ul { margin: 0; padding: 0; }
  ul, ol { list-style: none; }

  .page { width: min(100% - 2.5rem, 46rem); margin: 0 auto; padding: 3.5rem 0 2.5rem; }

  .intro { display: grid; grid-template-columns: auto 1fr; column-gap: 1rem; align-items: center; }
  .portrait { width: 3.25rem; height: 3.25rem; border-radius: 0.25rem; filter: grayscale(1) contrast(1.05); }
  .intro h1 { font-size: 1rem; font-weight: 700; }
  .opening { grid-column: 1 / -1; margin-top: 2rem; font-size: 1.375rem; line-height: 1.4; font-weight: 500; letter-spacing: -0.02em; }
  .stand-in { display: block; color: var(--muted); }
  .place { grid-column: 1 / -1; margin-top: 1.5rem; color: var(--muted); }
  .contact { grid-column: 1 / -1; display: flex; gap: 1.5rem; }

  section { margin-top: 4rem; }
  h2 { font-size: inherit; font-weight: 400; color: var(--muted); }
  h2::before { content: "## "; color: var(--line); }

  .item { display: grid; gap: 1rem; padding: 1.75rem 0; border-bottom: 1px dashed var(--line); }
  .text { display: grid; grid-template-columns: 2.5rem 1fr; }
  .text > :not(.n) { grid-column: 2; }
  .n { color: var(--muted); grid-row: 1; }
  .item h3 { font-size: 1.0625rem; font-weight: 700; }
  .kind { color: var(--accent); font-size: 0.8125rem; margin-bottom: 0.5rem; }
  .frame { display: grid; place-items: center; border: 1px dashed var(--line); background: var(--frame); color: var(--muted); font-size: 0.8125rem; text-align: center; padding: 1rem; margin-left: 2.5rem; }
  .media-phone .frame { aspect-ratio: 9 / 16; width: min(100% - 2.5rem, 12rem); border-radius: 1.25rem; }
  .media-mac .frame { aspect-ratio: 16 / 10; border-radius: 0.375rem; }

  .next { padding: 1.5rem 0 0 2.5rem; color: var(--muted); }

  .post { display: block; padding-top: 1rem; }
  .post-title { display: block; font-weight: 700; }
  .post-text { display: block; color: var(--muted); }

  .earlier ul { padding-top: 0.75rem; }
  .earlier li { padding: 0.125rem 0; }
  .earlier li::before { content: "- "; color: var(--muted); }
  .earlier span { color: var(--muted); }

  .looks { margin-top: 4rem; padding-top: 1rem; border-top: 1px dashed var(--line); color: var(--muted); font-size: 0.8125rem; display: flex; gap: 1rem; flex-wrap: wrap; }
  .looks ul { display: flex; gap: 1rem; }

  @media (min-width: 48rem) {
    .item.media-mac, .item.media-phone { grid-template-columns: minmax(0, 1fr) auto; align-items: start; }
    .media-mac .frame { width: 18rem; margin-left: 0; }
    .media-phone .frame { width: 10rem; margin-left: 0; }
  }
</style>
