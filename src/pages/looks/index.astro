---
import Page from "../../layouts/page.astro";
import { concepts } from "../../looks/content";
---

<Page title="Concepts" description="Homepage concepts, for comparison.">
  <main>
    <h1>Concepts</h1>
    <p>The same homepage in different directions. Each follows your phone's light or dark setting.</p>
    <ol>
      {concepts.map((c) => <li><a href={`/looks/${c.slug}`}>{c.name}</a></li>)}
    </ol>
  </main>
</Page>
