---
import Home from "../../looks/home.astro";
import font from "@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url";
---

<Home look="paper" font={font}>
  <style slot="head" is:inline set:html={`@font-face{font-family:Newsreader;src:url(${font}) format("woff2");font-weight:200 800;font-display:swap}`} />
</Home>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: light-dark(#f4f1ea, #15130f);
    --ink: light-dark(#1d1b17, #ece6da);
    --muted: light-dark(#6b645a, #a39b8d);
    --line: light-dark(#d9d2c4, #34302a);
    --accent: light-dark(#8a2b1d, #e39a7f);
    --frame: light-dark(#e9e4d8, #1f1c17);
    font-family: Newsreader, Georgia, serif;
    font-optical-sizing: auto;
    font-size: 1.1875rem;
    line-height: 1.55;
    background: var(--bg);
    color: var(--ink);
  }
  body { margin: 0; }
  a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  a:hover { color: var(--accent); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  h1, h2, h3, p, ol, ul { margin: 0; padding: 0; }
  ul, ol { list-style: none; }

  .page { width: min(100% - 2.5rem, 68rem); margin: 0 auto; padding: 4.5rem 0 3rem; }

  .intro { display: grid; grid-template-columns: 1fr auto; column-gap: 2rem; max-width: 46rem; }
  .portrait { grid-column: 2; grid-row: 1 / span 2; width: 5.5rem; height: 5.5rem; border-radius: 50%; filter: grayscale(0.2); }
  .intro h1 { font-size: 1.05rem; font-weight: 600; letter-spacing: 0.01em; }
  .opening { grid-column: 1 / -1; margin-top: 1.5rem; font-size: clamp(1.9rem, 4.6vw, 3.1rem); line-height: 1.12; font-weight: 380; letter-spacing: -0.015em; text-wrap: balance; }
  .stand-in { display: block; color: var(--muted); font-style: italic; }
  .place { grid-column: 1 / -1; margin-top: 1.5rem; color: var(--muted); font-size: 1rem; }
  .contact { grid-column: 1 / -1; display: flex; gap: 1.25rem; margin-top: 0.5rem; font-size: 1rem; }

  section { margin-top: 5.5rem; }
  h2 { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); padding-bottom: 0.75rem; border-bottom: 1px solid var(--line); }

  .item { display: grid; gap: 1.25rem; padding: 2.5rem 0; border-bottom: 1px solid var(--line); }
  .n { font-size: 0.85rem; color: var(--accent); font-variant-numeric: tabular-nums; }
  .item h3 { font-size: 1.75rem; line-height: 1.15; font-weight: 500; letter-spacing: -0.01em; margin-top: 0.25rem; }
  .kind { font-size: 0.9rem; color: var(--muted); margin: 0.25rem 0 0.75rem; font-style: italic; }
  .text p:last-child { max-width: 34ch; }
  .frame { display: grid; place-items: center; background: var(--frame); border-radius: 0.375rem; color: var(--muted); font-size: 0.85rem; font-style: italic; text-align: center; padding: 1rem; }
  .media-phone .frame { aspect-ratio: 9 / 16; width: min(100%, 13rem); border-radius: 1.75rem; }
  .media-mac .frame { aspect-ratio: 16 / 10; }
  .item-1 h3 { font-size: clamp(2rem, 5vw, 2.75rem); }

  .next { padding-top: 1.5rem; font-style: italic; color: var(--muted); }

  .post { display: block; text-decoration: none; padding-top: 1.5rem; max-width: 40rem; }
  .post-title { display: block; font-size: 1.9rem; line-height: 1.15; font-weight: 450; }
  .post:hover .post-title { text-decoration: underline; text-decoration-thickness: 1px; }
  .post-text { display: block; margin-top: 0.5rem; color: var(--muted); }

  .earlier ul { padding-top: 1rem; }
  .earlier li { padding: 0.35rem 0; }
  .earlier span { color: var(--muted); }

  .looks { margin-top: 5rem; padding-top: 1rem; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.9rem; display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .looks ul { display: flex; gap: 0.75rem; }

  @media (min-width: 48rem) {
    .item { grid-template-columns: 5rem minmax(0, 5fr) minmax(0, 7fr); column-gap: 2rem; align-items: start; }
    .item .text { display: contents; }
    .item .n { grid-column: 1; grid-row: 1; padding-top: 0.6rem; }
    .item .text > :not(.n) { grid-column: 2; }
    .item h3 { grid-row: 1; }
    .kind { grid-row: 2; }
    .text p:last-child { grid-row: 3; }
    .frame { grid-column: 3; grid-row: 1 / span 4; }
    .media-phone .frame { justify-self: start; }
    .next, .post, .earlier ul { margin-left: 7rem; }
  }
</style>
