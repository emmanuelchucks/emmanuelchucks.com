---
import Home from "../../looks/home.astro";
import font from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
---

<Home look="instrument" font={font}>
  <style slot="head" is:inline set:html={`@font-face{font-family:Geist;src:url(${font}) format("woff2");font-weight:100 900;font-display:swap}`} />
</Home>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: light-dark(#fbfbfa, #0d0d0e);
    --ink: light-dark(#121212, #ededec);
    --muted: light-dark(#6e6e6b, #8e8e8a);
    --line: light-dark(#e6e6e3, #222224);
    --accent: light-dark(#e04a00, #ff7a3d);
    --frame: light-dark(#efefed, #18181a);
    font-family: Geist, system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.55;
    background: var(--bg);
    color: var(--ink);
    font-feature-settings: "ss01";
  }
  body { margin: 0; }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--accent); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 2px; }
  h1, h2, h3, p, ol, ul { margin: 0; padding: 0; }
  ul, ol { list-style: none; }

  .page { width: min(100% - 2.5rem, 76rem); margin: 0 auto; padding: 3rem 0 2.5rem; display: grid; gap: 4rem; }

  .portrait { width: 3rem; height: 3rem; border-radius: 0.5rem; }
  .intro h1 { margin-top: 1.5rem; font-size: clamp(2.6rem, 9vw, 4.5rem); line-height: 0.95; font-weight: 640; letter-spacing: -0.045em; }
  .opening { margin-top: 1.25rem; font-size: 1.25rem; line-height: 1.4; letter-spacing: -0.01em; max-width: 28ch; color: var(--muted); }
  .stand-in { display: block; color: var(--ink); }
  .place { margin-top: 1.25rem; font-size: 0.875rem; color: var(--muted); }
  .contact { display: flex; gap: 1rem; margin-top: 0.25rem; font-size: 0.875rem; font-weight: 500; }
  .contact a { text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 0.25em; }

  section + section { margin-top: 3.5rem; }
  h2 { font-size: 0.8125rem; font-weight: 500; color: var(--muted); padding-bottom: 0.75rem; }

  .work ol { display: grid; gap: 0.75rem; }
  .item { display: grid; gap: 1rem; padding: 1.25rem; background: light-dark(#fff, #131315); border: 1px solid var(--line); border-radius: 0.75rem; }
  .n { font-size: 0.75rem; color: var(--accent); font-variant-numeric: tabular-nums; font-weight: 500; }
  .item h3 { font-size: 1.375rem; font-weight: 600; letter-spacing: -0.025em; margin-top: 0.25rem; }
  .kind { font-size: 0.8125rem; color: var(--muted); margin: 0.125rem 0 0.5rem; }
  .text p:last-child { max-width: 46ch; }
  .frame { display: grid; place-items: center; background: var(--frame); border-radius: 0.5rem; color: var(--muted); font-size: 0.8125rem; text-align: center; padding: 1rem; }
  .media-phone .frame { aspect-ratio: 9 / 16; width: min(100%, 13rem); border-radius: 1.5rem; }
  .media-mac .frame { aspect-ratio: 16 / 10; }
  .item-1 { padding: 1.5rem; }
  .item-1 h3 { font-size: 1.75rem; }

  .next { padding: 1rem 1.25rem 0; color: var(--muted); font-size: 0.9375rem; }

  .post { display: block; padding: 1.25rem; border: 1px solid var(--line); border-radius: 0.75rem; }
  .post-title { display: block; font-size: 1.25rem; font-weight: 600; letter-spacing: -0.02em; }
  .post-text { display: block; margin-top: 0.25rem; color: var(--muted); }

  .earlier li { display: flex; gap: 0.75rem; justify-content: space-between; padding: 0.625rem 0; border-top: 1px solid var(--line); font-size: 0.9375rem; }
  .earlier span { color: var(--muted); text-align: right; }

  .looks { grid-column: 1 / -1; padding-top: 1rem; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.8125rem; display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .looks ul { display: flex; gap: 0.75rem; }
  .looks a { color: var(--ink); text-decoration: underline; }

  @media (min-width: 60rem) {
    .page { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: 4rem; padding-top: 4rem; }
    .intro { position: sticky; top: 4rem; align-self: start; grid-row: 1 / span 3; }
    .page > section { grid-column: 2; }
    .page > section + section { margin-top: 0; }
    .item.media-mac, .item.media-phone { grid-template-columns: minmax(0, 1fr) auto; align-items: start; }
    .media-mac .frame { width: 20rem; }
    .media-phone .frame { width: 11rem; }
  }
</style>
