---
import { Image } from "astro:assets";
import font from "@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url";
import portrait from "../../assets/portrait.webp";
import Shell from "../../looks/shell.astro";
import { article, contact, earlier, intro, next, work } from "../../looks/content";
---

<Shell slug="room" font={font} family="Fraunces" axes="font-weight:100 900;">
  <main class="room">
    <header class="intro">
      <h1>Emmanuel<br />Chucks</h1>
      <div class="print"><Image src={portrait} alt="Emmanuel Chucks" width={128} height={128} /></div>
      <p class="line">{intro.line}</p>
      <p class="meta">{intro.place} — {contact.map((c, i) => <>{i > 0 && ", "}<a href={c.href}>{c.label}</a></>)}</p>
    </header>

    <ol class="work">
      {
        work.map((w) => (
          <li>
            <h2>{w.title}</h2>
            <p class="text">{w.text}</p>
            <p class="kind">{w.kind}</p>
          </li>
        ))
      }
    </ol>
    <p class="next">{next}</p>

    <footer class="end">
      <p><span>Writing</span> <a href="#">{article.title}</a></p>
      <p><span>Earlier</span> {earlier.map((e, i) => <>{i > 0 && ", "}<a href={e.href}>{e.title}</a></>)}</p>
    </footer>
  </main>
</Shell>

<style is:global>
  :root {
    color-scheme: light dark;
    --room: light-dark(#e4572e, #2b0f0a);
    --ink: light-dark(#1c0a05, #ff9468);
    --soft: light-dark(rgb(28 10 5 / 0.62), rgb(255 148 104 / 0.6));
    --tile: light-dark(rgb(28 10 5 / 0.045), rgb(255 148 104 / 0.035));
    --rule: light-dark(rgb(28 10 5 / 0.22), rgb(255 148 104 / 0.2));
    background-color: var(--room);
    background-image:
      linear-gradient(90deg, var(--room) 4px, transparent 4px),
      linear-gradient(var(--room) 4px, transparent 4px),
      linear-gradient(var(--tile), var(--tile));
    background-size: 244px 244px, 244px 244px, auto;
    background-position: -2px -2px;
    color: var(--ink);
    font-family: Fraunces, Georgia, serif;
    font-variation-settings: "SOFT" 100, "WONK" 0;
    font-size: 18px;
    line-height: 1.45;
  }
  body { margin: 0; position: relative; }
  body::before { content: ""; position: fixed; inset: 0; pointer-events: none; background: var(--grain); opacity: 0.09; mix-blend-mode: multiply; }
  a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  a:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  h1, h2, p, ol { margin: 0; padding: 0; }
  ol { list-style: none; }

  .room { position: relative; padding: clamp(28px, 5vw, 64px); max-width: 1320px; }

  .intro { display: grid; grid-template-columns: 1fr auto; align-items: end; column-gap: 32px; }
  .intro h1 {
    font-size: clamp(64px, 15vw, 220px); font-weight: 340; line-height: 0.82; letter-spacing: -0.045em;
    font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 144;
  }
  .print { width: clamp(84px, 11vw, 150px); aspect-ratio: 1; background: light-dark(#e4572e, #ff9468); }
  .print img { display: block; width: 100%; height: 100%; filter: grayscale(1) contrast(1.3) brightness(1.1); mix-blend-mode: multiply; }
  .line { grid-column: 1 / -1; margin-top: 36px; font-size: clamp(22px, 2.6vw, 32px); line-height: 1.15; max-width: 22ch; font-variation-settings: "SOFT" 100, "opsz" 48; }
  .meta { grid-column: 1 / -1; margin-top: 18px; color: var(--soft); font-size: 16px; }

  .work { margin-top: clamp(72px, 10vw, 140px); border-top: 1px solid var(--rule); }
  .work li {
    display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr) minmax(0, 2fr); gap: 24px; align-items: baseline;
    padding: 22px 0; border-bottom: 1px solid var(--rule); transition: padding 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .work li:hover { padding-left: 14px; transition-duration: 220ms; }
  .work h2 { font-size: clamp(28px, 3.8vw, 52px); font-weight: 420; line-height: 1; letter-spacing: -0.03em; font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 96; }
  .work .text { font-size: 16px; color: var(--soft); max-width: 40ch; }
  .work .kind { font-size: 13px; color: var(--soft); text-align: right; font-style: italic; }
  .next { padding: 22px 0; font-style: italic; color: var(--soft); border-bottom: 1px dashed var(--rule); }

  .end { margin-top: clamp(64px, 8vw, 120px); display: grid; gap: 10px; font-size: 17px; }
  .end span { display: inline-block; width: 6.5em; color: var(--soft); font-style: italic; }

  @media (max-width: 760px) {
    .work li { grid-template-columns: 1fr auto; row-gap: 6px; }
    .work .text { grid-column: 1 / -1; grid-row: 2; }
    .work .kind { grid-row: 1; grid-column: 2; }
    .end span { display: block; }
  }
  @media (prefers-reduced-motion: reduce) { .work li { transition: none; } }
</style>
