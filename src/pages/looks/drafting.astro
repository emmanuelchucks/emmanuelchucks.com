---
import { Image } from "astro:assets";
import font from "@fontsource-variable/martian-mono/files/martian-mono-latin-standard-normal.woff2?url";
import portrait from "../../assets/portrait.webp";
import Shell from "../../looks/shell.astro";
import { article, contact, earlier, intro, next, work } from "../../looks/content";
---

<Shell slug="drafting" font={font} family="Martian" axes="font-weight:100 800;font-stretch:75% 112.5%;">
  <div class="ruler" aria-hidden="true"></div>
  <div class="mark" aria-hidden="true"><span></span></div>
  <main class="sheet">
    <header class="intro">
      <Image src={portrait} alt="Emmanuel Chucks" width={128} height={128} class="face" />
      <h1>{intro.name}</h1>
      <p class="line">{intro.line}</p>
      <p class="meta">{intro.place}</p>
      <ul class="contact">{contact.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
    </header>

    <ol class="work">
      {
        work.map((w, i) => (
          <li class={`w${i + 1}`}>
            <p class="fig">FIG. {String(i + 1).padStart(2, "0")}</p>
            <h2>{w.title}</h2>
            <p class="kind">{w.kind}</p>
            <p class="text">{w.text}</p>
          </li>
        ))
      }
      <li class="next">
        <p class="fig">FIG. 05</p>
        <p class="text">{next}</p>
      </li>
    </ol>

    <section class="notes">
      <h2>Writing</h2>
      <p><a href="#">{article.title}</a></p>
      <h2>Earlier</h2>
      <ul>{earlier.map((e) => <li><a href={e.href}>{e.title}</a> {e.text}</li>)}</ul>
    </section>
  </main>
  <aside class="block" aria-hidden="true">
    <span>Drawn by</span><span>E. Chucks</span>
    <span>Place</span><span>Accra</span>
    <span>Sheet</span><span>01 of 01</span>
    <span>Scale</span><span>1 : 1</span>
  </aside>
</Shell>

<style is:global>
  @property --y { syntax: "<integer>"; inherits: true; initial-value: 0; }
  :root {
    color-scheme: light dark;
    --paper: light-dark(#ecebe4, #121311);
    --ink: light-dark(#23231f, #d9d9d0);
    --muted: light-dark(#7b7a70, #7d7d74);
    --minor: light-dark(rgb(40 40 30 / 0.045), rgb(255 255 240 / 0.03));
    --major: light-dark(rgb(40 40 30 / 0.09), rgb(255 255 240 / 0.065));
    --red: light-dark(#d9461c, #ff6a3d);
    --unit: 240px;
    background:
      linear-gradient(var(--major) 1px, transparent 1px) 0 0 / var(--unit) var(--unit),
      linear-gradient(90deg, var(--major) 1px, transparent 1px) 0 0 / var(--unit) var(--unit),
      linear-gradient(var(--minor) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, var(--minor) 1px, transparent 1px) 0 0 / 24px 24px,
      var(--paper);
    color: var(--ink);
    font-family: Martian, ui-monospace, monospace;
    font-size: 13px;
    font-stretch: 87.5%;
    line-height: 1.75;
  }
  @keyframes depth { to { --y: 100; } }
  body { margin: 0; }
  a { color: inherit; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  a:hover { color: var(--red); }
  :focus-visible { outline: 1px solid var(--red); outline-offset: 3px; }
  h1, h2, p, ul, ol { margin: 0; padding: 0; }
  ul, ol { list-style: none; }

  /* Ruler down the left edge: a tick every 8px, longer every 40px and 240px. */
  .ruler {
    position: fixed; inset: 0 auto 0 0; width: 28px; border-right: 1px solid var(--major);
    background:
      linear-gradient(var(--ink) 1px, transparent 1px) right 0 top 0 / 22px 240px repeat-y,
      linear-gradient(var(--muted) 1px, transparent 1px) right 0 top 0 / 14px 40px repeat-y,
      linear-gradient(var(--muted) 1px, transparent 1px) right 0 top 0 / 7px 8px repeat-y;
    opacity: 0.55;
  }
  /* The reading mark: a red hairline fixed at a third of the screen, with how far down you are. */
  .mark { position: fixed; top: 33vh; left: 0; width: 120px; height: 1px; background: var(--red); }
  .mark::before { content: ""; position: absolute; left: 24px; top: -4px; width: 9px; height: 9px; border-radius: 50%; background: var(--red); }
  .mark span { position: absolute; left: 40px; top: -18px; font-size: 10px; color: var(--red); font-variant-numeric: tabular-nums; }
  /* Kept apart from the animation shorthand: the CSS minifier merges them, and browsers reject a timeline inside the shorthand. */
  .mark > span { animation-name: depth; animation-timing-function: linear; animation-fill-mode: both; }
  .mark span:not(:empty), .mark span:empty { animation-timeline: scroll(root); }
  .mark span::after { counter-reset: y var(--y); content: counter(y) "%"; }

  .sheet { padding: 96px 32px 120px 120px; max-width: 760px; }

  .intro { display: grid; grid-template-columns: 1fr auto; column-gap: 24px; }
  .face { grid-column: 2; grid-row: 1 / span 3; width: 72px; height: 72px; filter: grayscale(1) contrast(1.1); }
  .intro h1 { font-size: clamp(30px, 5.6vw, 52px); font-weight: 760; font-stretch: 112.5%; line-height: 1; letter-spacing: -0.04em; }
  .line { margin-top: 18px; font-size: 15px; max-width: 34ch; line-height: 1.5; }
  .meta { margin-top: 18px; color: var(--muted); }
  .contact { display: flex; gap: 20px; }

  .work { margin-top: 96px; display: grid; gap: 56px; }
  .work li { position: relative; display: grid; grid-template-columns: 96px 1fr; column-gap: 16px; }
  .work li > :not(.fig) { grid-column: 2; }
  .fig { grid-row: 1 / span 3; color: var(--red); font-size: 10px; letter-spacing: 0.08em; padding-top: 6px; border-top: 1px solid var(--red); align-self: start; }
  .work h2 { font-size: 22px; font-weight: 650; font-stretch: 100%; letter-spacing: -0.03em; line-height: 1.2; }
  .w1 h2 { font-size: 34px; font-stretch: 112.5%; }
  .kind { color: var(--muted); font-size: 11px; }
  .text { margin-top: 8px; max-width: 48ch; }
  .next .text { margin-top: 0; color: var(--muted); padding: 10px 12px; border: 1px dashed var(--major); }
  .next .fig { color: var(--muted); border-color: var(--muted); }

  .notes { margin-top: 96px; display: grid; grid-template-columns: 96px 1fr; column-gap: 16px; row-gap: 6px; }
  .notes h2 { grid-column: 1; font-size: 10px; font-weight: 400; color: var(--muted); letter-spacing: 0.08em; text-transform: uppercase; padding-top: 4px; }
  .notes p, .notes ul { grid-column: 2; margin-bottom: 24px; }
  .notes p a { font-size: 17px; font-weight: 600; letter-spacing: -0.02em; }
  .notes li { color: var(--muted); }
  .notes li a { color: var(--ink); }

  .block {
    position: fixed; right: 24px; bottom: 64px; display: grid; grid-template-columns: auto auto;
    border: 1px solid var(--muted); font-size: 10px; line-height: 1; color: var(--muted); background: var(--paper);
  }
  .block span { padding: 7px 10px; border-bottom: 1px solid var(--major); }
  .block span:nth-child(odd) { border-right: 1px solid var(--major); text-transform: uppercase; letter-spacing: 0.08em; font-size: 9px; }
  .block span:nth-child(even) { color: var(--ink); }
  .block span:nth-last-child(-n + 2) { border-bottom: 0; }

  @media (max-width: 1100px) { .block { display: none; } }
  @media (max-width: 640px) {
    .mark { top: 55vh; width: 36px; }
    .mark span { display: none; }
    .sheet { padding: 64px 20px 96px 48px; }
    .mark { width: 40px; }
    .work li, .notes { grid-template-columns: 1fr; }
    .work li > :not(.fig), .notes h2, .notes p, .notes ul { grid-column: 1; }
    .fig { grid-row: auto; margin-bottom: 8px; width: 64px; }
    .w1 h2 { font-size: 26px; }
    .face { width: 56px; height: 56px; }
  }
</style>
