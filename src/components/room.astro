---
// The room every page sits in: the tile wall from the earlier site and the window light drifting across it.
const tiles = Array.from({ length: 77 }, (_, i) => i);
---

<div class="wall" aria-hidden="true">{tiles.map(() => <i></i>)}</div>
<div class="window" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: light-dark(#e5e2db, #0a0a0b);
    --ink: light-dark(#191816, #e9e9e6);
    --text: light-dark(#45433e, #b4b4af);
    --muted: light-dark(#5f5c56, #9a9a95);
    --tile: light-dark(rgb(0 0 0 / 0.022), rgb(255 255 255 / 0.016));
    --tile-lit: light-dark(rgb(0 0 0 / 0.045), rgb(255 255 255 / 0.035));
    --sun: light-dark(rgb(255 250 236 / 0.9), rgb(170 190 230 / 0.14));
    --contact: light-dark(rgb(60 48 28 / 0.14), rgb(0 0 0 / 0.5));
    --shade: light-dark(rgb(60 48 28 / 0.06), rgb(0 0 0 / 0.25));
    --edge: light-dark(rgb(0 0 0 / 0.06), rgb(255 255 255 / 0.09));
    background: var(--bg);
    color: var(--ink);
    font-family: Bricolage, system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.5;
  }
  body { margin: 0; }
  a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  :focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; border-radius: 2px; }
  h1, h2, p, ol, ul, figure { margin: 0; padding: 0; }
  ol, ul { list-style: none; }

  .wall {
    position: fixed; z-index: -1; top: 50%; left: 50%; translate: -50% -50%;
    display: grid; grid-template-columns: repeat(11, 240px); grid-auto-rows: 240px; gap: 4px;
  }
  .wall i { background: var(--tile); border-radius: 1px; transition: background-color 600ms ease-out; }
  .wall i:hover { background: var(--tile-lit); transition-duration: 120ms; }

  /* Light through a four-pane window, drifting across the wall over a minute and a half. */
  .window {
    position: fixed; z-index: 0; top: -12vh; left: -14vw; width: min(70vw, 780px); height: min(92vh, 920px);
    display: grid; grid-template: 1fr 1fr / 1fr 1fr; gap: 26px; pointer-events: none;
    transform: perspective(900px) rotateY(-22deg) rotateZ(-9deg) skewX(-8deg);
    animation: drift 90s ease-in-out infinite alternate;
  }
  .window i { background: var(--sun); border-radius: 6px; }
  @keyframes drift {
    from { translate: 0 0; opacity: 0.85; }
    to { translate: 60vw 22vh; opacity: 0.5; }
  }
  @media (prefers-color-scheme: light) { .window { mix-blend-mode: soft-light; filter: blur(22px); } }
  @media (prefers-color-scheme: dark) { .window { mix-blend-mode: screen; filter: blur(28px); } }

  /* Things on the wall sit close to it: a tight contact shadow, and a faint soft one that drifts a
     couple of pixels against the light as it crosses. */
  .casts { filter: drop-shadow(0 0.5px 0.75px var(--contact)) drop-shadow(2px 3px 8px var(--shade)); animation: cast 90s ease-in-out infinite alternate; }
  @keyframes cast {
    from { filter: drop-shadow(0 0.5px 0.75px var(--contact)) drop-shadow(2px 3px 8px var(--shade)); }
    to { filter: drop-shadow(0 0.5px 0.75px var(--contact)) drop-shadow(-2px 3px 8px var(--shade)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .window, .casts { animation: none; }
    .window { translate: 22vw 8vh; }
    .wall i { transition: none; }
  }
</style>
