---
// A project's own page: its icon and words, then its best moments, each with a heading, a sentence or two,
// and the screens or clips that show it, standing on the wall in the light.
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import Page from "../layouts/page.astro";
import { intro } from "../site";

export interface Screen {
  light: ImageMetadata;
  /** The same screen in dark mode, when the app has one. */
  dark?: ImageMetadata;
  alt: string;
  /** What the capture is: a phone screen (the default), a close-up cropped from one, a Mac window,
   *  a menu bar panel, or a clip. Mac captures are square-cornered; the page rounds them as macOS does. */
  frame?: "phone" | "detail" | "window" | "menu" | "clip";
  /** A short silent loop to play instead of the image, which stays as its still for reduced motion.
   *  Paths without extension: each is served as .av1.mp4 and, for browsers without AV1, .mp4 (H.264). */
  video?: { light: string; dark?: string };
}
export interface Step {
  title?: string;
  text: string;
  /** One screen, or two shown side by side. */
  screens: Screen[];
}
interface Props {
  title: string;
  kind: string;
  text: string;
  description: string;
  steps?: Step[];
  note: string;
}
const { title, kind, text, description, steps = [], note } = Astro.props;
const widths = { phone: 340, detail: 460, window: 760, menu: 300, clip: 640 } as const;
// Main profile, 8-bit, up to level 5.0 (the 1206 × 2622 phone clips); a browser that can't decode it gets the H.264 file.
const av1 = 'video/mp4; codecs="av01.0.12M.08"';
const shown = await Promise.all(
  steps.map(async (step) => ({
    title: step.title,
    text: step.text,
    wide: step.screens.some((s) => s.frame === "window" || s.frame === "clip"),
    stacked: step.screens.every((s) => s.frame === "detail"),
    screens: await Promise.all(
      step.screens.map(async ({ light, dark, alt, frame = "phone", video }) => {
        // Phones read these on 3x screens; phone and menu bar captures are made wide enough for it.
        const size = { width: widths[frame], densities: frame === "phone" || frame === "menu" ? [1, 2, 3] : [1, 2] };
        // AVIF is about 40% smaller at the same sharpness; WebP is for browsers without it.
        const both = async (src: ImageMetadata) => ({
          avif: await getImage({ src, ...size, format: "avif", quality: 70 }),
          webp: await getImage({ src, ...size, format: "webp", quality: 90 }),
        });
        return { alt, frame, video, light: await both(light), dark: dark && (await both(dark)) };
      }),
    ),
  })),
);
---

<Page title={`${title} · ${intro.name}`} description={description}>
  <main class="page">
    <a class="back" href="/">{intro.name}</a>
    <header class="head">
      <slot name="icon" />
      <div>
        <h1>{title}</h1>
        <p class="kind">{kind}</p>
      </div>
    </header>
    <p class="text">{text}</p>
  </main>

  <div class="steps">
    <slot name="demo" />
    {
      shown.map((step) => (
        <section class:list={["step", { wide: step.wide, stacked: step.stacked, two: step.screens.length > 1 }]}>
          <div class="words">
            {step.title && <h2>{step.title}</h2>}
            <p>{step.text}</p>
          </div>
          <div class="screens">
            {step.screens.map((s) => (
              <figure class={s.frame}>
                {s.video && (
                  <>
                    <video class:list={["screen casts motion", { "for-light": s.video.dark }]} preload="none" muted loop playsinline width={s.light.webp.attributes.width} height={s.light.webp.attributes.height} aria-label={s.alt}>
                      <source src={`${s.video.light}.av1.mp4`} type={av1} />
                      <source src={`${s.video.light}.mp4`} type="video/mp4" />
                    </video>
                    {s.video.dark && (
                      <video class="screen casts motion for-dark" preload="none" muted loop playsinline width={s.light.webp.attributes.width} height={s.light.webp.attributes.height} aria-label={s.alt}>
                        <source src={`${s.video.dark}.av1.mp4`} type={av1} />
                        <source src={`${s.video.dark}.mp4`} type="video/mp4" />
                      </video>
                    )}
                  </>
                )}
                <picture class:list={["screen casts", { still: s.video }]}>
                  {s.dark && <source media="(prefers-color-scheme: dark)" type="image/avif" srcset={s.dark.avif.srcSet.attribute} />}
                  {s.dark && <source media="(prefers-color-scheme: dark)" type="image/webp" srcset={s.dark.webp.srcSet.attribute} />}
                  <source type="image/avif" srcset={s.light.avif.srcSet.attribute} />
                  <img src={s.light.webp.src} srcset={s.light.webp.srcSet.attribute} width={s.light.webp.attributes.width} height={s.light.webp.attributes.height} alt={s.alt} loading="lazy" decoding="async" />
                </picture>
              </figure>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <p class="note">{note}</p>
</Page>

<style is:global>
  /* Here the light falls on the screens too, so it sits above them and below the words. */
  .daylight { z-index: 1; }
  .page, .note, .step > .words { position: relative; z-index: 2; }
  .page { width: min(100% - 48px, 600px); margin: 0 auto; padding: 14vh 0 0; }

  .back { color: var(--muted); font-size: 15px; text-decoration: none; }
  .back::before { content: "← "; }
  .back:hover { color: var(--ink); }

  .head { display: flex; gap: 20px; align-items: center; margin-top: 48px; }
  .head h1 { font-size: 34px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; font-variation-settings: "opsz" 96; }
  .kind { margin-top: 4px; color: var(--muted); font-size: 14px; }
  .text { margin-top: 24px; max-width: 46ch; font-size: 18px; color: var(--text); }

  .icon { position: relative; display: block; width: 56px; height: 56px; flex: none; }
  .icon img { display: block; width: 56px; height: 56px; border-radius: 22.5%; }
  .pair img { position: absolute; width: 40px; height: 40px; border-radius: 0; }
  .pair img:first-child { left: 18px; top: 18px; }
  .pair img:last-child { left: 0; top: 0; }
  .head .icon.mac { width: 70px; height: 70px; margin: -7px; }
  .head .icon.mac img, .head img.icon.mac { width: 70px; height: 70px; border-radius: 0; }

  /* Each step is one moment: its heading and words, then its screens. On wide screens the words sit beside
     the screens, alternating sides; a Mac window or a clip is too wide for that and keeps its words above. */
  .steps { display: grid; justify-items: center; gap: 128px; padding: 112px 24px 0; }
  .step { display: grid; width: min(100%, 1080px); align-items: center; justify-content: center; column-gap: 88px; row-gap: 28px;
    grid-template-columns: auto auto; grid-template-areas: "words screens"; }
  .step:nth-child(even of .step:not(.wide)) { grid-template-areas: "screens words"; }
  .step.wide { grid-template-columns: 1fr; grid-template-areas: "words" "screens"; width: min(100%, 760px); }
  .step > .words { grid-area: words; max-width: 36ch; }
  .wide > .words, .dictation > .words { max-width: 40ch; }
  :is(.step, .dictation) > .words h2 { font-size: 26px; font-weight: 700; letter-spacing: -0.025em; line-height: 1.15; }
  :is(.step, .dictation) > .words p { color: var(--text); font-size: 18px; line-height: 1.5; }
  :is(.step, .dictation) > .words h2 + p { margin-top: 12px; }
  .step > .words p:only-child { color: var(--ink); font-size: 22px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; }
  /* A demo in the slot comes before the steps, with a heading and words like theirs. */
  .steps > .dictation { display: grid; gap: 28px; width: min(100%, 760px); }
  .screens { grid-area: screens; display: flex; gap: 32px; justify-content: center; align-items: center; }
  .stacked .screens { flex-direction: column; gap: 20px; }
  .screens figure { margin: 0; width: 340px; }
  .two .screens figure { width: 290px; }
  .screens figure.menu { width: 300px; }
  .stacked .screens figure.detail { width: 460px; }
  .screens figure:is(.window, .clip) { width: 100%; }

  .screen, .screen img { display: block; width: 100%; height: auto; }
  .screen img { border-radius: 48px; outline: 1px solid var(--edge); outline-offset: -1px; }
  .two .screen img, .two video.screen { border-radius: 41px; }
  video.phone, .phone video.screen { border-radius: 48px; }
  /* Mac windows and menu bar panels are drawn offscreen from the app's own views, square-cornered;
     the radius here is macOS 26's (about 16 pt for windows, 12 pt for menu bar panels). */
  .detail .screen img, .detail video.screen { border-radius: 24px; }
  .window .screen img { border-radius: 2.1% / 3.15%; }
  .menu .screen img, .menu video.screen { border-radius: 4.3% / 3.75%; }
  /* A clip plays on its own; with reduced motion its last frame stands in for it. */
  .clip .screen, .clip .screen img { border-radius: 12px; }
  video.screen { display: block; width: 100%; height: auto; outline: 1px solid var(--edge); outline-offset: -1px; }
  .still { display: none; }
  /* <source media> is only read when a video loads, so each mode gets its own video and CSS shows one.
     The script below loads and plays a clip only once it's shown and near the screen. */
  @media (prefers-color-scheme: dark) { video.for-light { display: none; } }
  @media (prefers-color-scheme: light) { video.for-dark { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .motion { display: none; }
    .still { display: block; }
  }
  .note { width: min(100% - 48px, 600px); margin: 96px auto 0; padding-bottom: 120px; color: var(--muted); font-size: 13px; }

  /* Too narrow for words beside two phones: the words go above, everything left-aligned in one column. */
  @media (max-width: 1120px) {
    .step, .step:nth-child(even of .step:not(.wide)) { width: min(100%, 600px); grid-template-columns: 1fr; grid-template-areas: "words" "screens"; }
    .step > .words { max-width: 40ch; }
    .screens { justify-content: flex-start; }
    .stacked .screens { align-items: flex-start; }
    .two .screens figure { width: calc(50% - 16px); }
  }
  @media (max-width: 760px) {
    .head h1 { font-size: 28px; }
    .steps { gap: 88px; padding-top: 72px; }
    :is(.step, .dictation) > .words h2 { font-size: 23px; }
    :is(.step, .dictation) > .words p { font-size: 17px; }
    .step > .words p:only-child { font-size: 19px; }
    .screens { justify-content: flex-start; gap: 14px; }
    .screens figure { width: min(80vw, 340px); }
    /* Two phones side by side would each be half a phone's width, too small to read, so they stack. */
    .two .screens { flex-direction: column; align-items: flex-start; gap: 28px; }
    .two .screens figure { width: min(80vw, 340px); }
    .phone .screen img, video.phone, .phone video.screen, .two .screen img, .two video.screen { border-radius: min(11.5vw, 48px); }
    .stacked .screens figure.detail { width: 100%; }
    .detail .screen img, .detail video.screen { border-radius: min(5vw, 24px); }
  }
</style>

<script>
  // A clip loads and plays only when it's near the screen. One hidden by the colour scheme or reduced motion
  // has no box, so it never intersects and is never downloaded; switching scheme shows the other, which then does.
  const clips = new IntersectionObserver(
    (entries) => {
      for (const { target, isIntersecting } of entries) {
        const video = target as HTMLVideoElement;
        if (isIntersecting) void video.play().catch(() => {});
        else video.pause();
      }
    },
    { rootMargin: "50% 0px" },
  );
  for (const video of document.querySelectorAll<HTMLVideoElement>("video.screen")) clips.observe(video);
</script>
