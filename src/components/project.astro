---
// A project's own page: its icon and words, then its screens standing on the wall in the light.
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import Page from "../layouts/page.astro";
import { intro } from "../site";

interface Shot {
  light: ImageMetadata;
  /** The same screen in dark mode, when the app has one. */
  dark?: ImageMetadata;
  alt: string;
  caption: string;
  /** What the capture is: a phone screen (the default), a Mac window, or a small floating panel.
   *  Windows and panels come with their own corners cut out of the image. */
  frame?: "phone" | "window" | "panel" | "clip";
  /** A short silent loop to play instead of the image, which stays as its still for reduced motion.
   *  Paths without extension: each is served as .mp4 (H.264) and .webm (VP9). */
  video?: { light: string; dark?: string };
}
interface Props {
  title: string;
  kind: string;
  text: string;
  description: string;
  shots?: Shot[];
  note: string;
}
const { title, kind, text, description, shots = [], note } = Astro.props;
const size = { width: 280, densities: [1, 2], format: "webp", quality: 72 } as const;
const widths = { phone: 280, window: 720, panel: 320, clip: 640 } as const;
const screens = await Promise.all(
  shots.map(async ({ light, dark, alt, caption, frame = "phone", video }) => {
    const options = { ...size, width: widths[frame], quality: frame === "phone" ? 72 : 80 };
    return {
      alt,
      caption,
      frame,
      video,
      light: await getImage({ src: light, ...options }),
      dark: dark && (await getImage({ src: dark, ...options })),
    };
  }),
);
---

<Page title={`${title} · ${intro.name}`} description={description}>
  <main class="page">
    <a class="back" href="/">{intro.name}</a>
    <header class="head">
      <slot name="icon" />
      <div>
        <h1>{title}</h1>
        <p class="kind">{kind}</p>
      </div>
    </header>
    <p class="text">{text}</p>
  </main>

  <section class="shots" aria-label="Screens">
    <slot name="demo" />
    {
      screens.map((s) => (
        <figure class={s.frame}>
          <figcaption>{s.caption}</figcaption>
          {s.video && (
            <>
              <video class:list={["screen casts motion", { "for-light": s.video.dark }]} autoplay muted loop playsinline width={s.light.attributes.width} height={s.light.attributes.height} aria-label={s.alt}>
                <source src={`${s.video.light}.mp4`} type="video/mp4" />
                <source src={`${s.video.light}.webm`} type="video/webm" />
              </video>
              {s.video.dark && (
                <video class="screen casts motion for-dark" autoplay muted loop playsinline width={s.light.attributes.width} height={s.light.attributes.height} aria-label={s.alt}>
                  <source src={`${s.video.dark}.mp4`} type="video/mp4" />
                  <source src={`${s.video.dark}.webm`} type="video/webm" />
                </video>
              )}
            </>
          )}
          <picture class:list={["screen casts", { still: s.video }]}>
            {s.dark && <source media="(prefers-color-scheme: dark)" srcset={s.dark.srcSet.attribute} />}
            <img src={s.light.src} srcset={s.light.srcSet.attribute} width={s.light.attributes.width} height={s.light.attributes.height} alt={s.alt} />
          </picture>
        </figure>
      ))
    }
  </section>

  <p class="note">{note}</p>
</Page>

<style is:global>
  /* Here the light falls on the screens too, so it sits above them and below the words. */
  .daylight { z-index: 1; }
  .page, .note { position: relative; z-index: 2; }
  .page { width: min(100% - 48px, 600px); margin: 0 auto; padding: 14vh 0 0; }

  .back { color: var(--muted); font-size: 15px; text-decoration: none; }
  .back::before { content: "← "; }
  .back:hover { color: var(--ink); }

  .head { display: flex; gap: 20px; align-items: center; margin-top: 48px; }
  .head h1 { font-size: 34px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; font-variation-settings: "opsz" 96; }
  .kind { margin-top: 4px; color: var(--muted); font-size: 14px; }
  .text { margin-top: 24px; max-width: 44ch; font-size: 18px; }

  .icon { position: relative; display: block; width: 56px; height: 56px; flex: none; }
  .icon img { display: block; width: 56px; height: 56px; border-radius: 22.5%; }
  .pair img { position: absolute; width: 40px; height: 40px; border-radius: 0; }
  .pair img:first-child { left: 18px; top: 18px; }
  .pair img:last-child { left: 0; top: 0; }

  /* Each screen is one step of the story: its sentence, then the screen. On wide screens a phone screen
     sits beside its sentence, alternating sides; wide captures keep the sentence above. */
  .shots { display: grid; justify-items: center; gap: 96px; padding: 88px 24px 0; }
  .shots figure { margin: 0; display: grid; gap: 22px; width: min(100%, 720px); }
  .shots figcaption { max-width: 22em; color: var(--ink); font-size: 21px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; }
  .shots figure.phone { width: min(100%, 680px); grid-template-columns: 280px 1fr; grid-template-areas: "screen words"; align-items: center; column-gap: 64px; }
  .shots figure.phone:nth-of-type(even) { grid-template-columns: 1fr 280px; grid-template-areas: "words screen"; }
  .shots figure.phone > figcaption { grid-area: words; }
  .shots figure.phone > :not(figcaption) { grid-area: screen; }
  .screen, .screen img { display: block; width: 100%; height: auto; }
  .screen img { border-radius: 40px; outline: 1px solid var(--edge); outline-offset: -1px; }
  /* Mac windows and panels have their own border trimmed off and corners cut out of the capture
     (computer use returns JPEGs); the radius here matches that cut so our hairline follows it. */
  .shots figure.panel { width: min(100%, 320px); }
  .window .screen img { border-radius: 1.45% / 2.39%; }
  .panel .screen img { border-radius: 3.8% / 12.5%; }
  /* A clip plays on its own; with reduced motion its last frame stands in for it. */
  .clip .screen, .clip .screen img { border-radius: 12px; }
  video.screen { display: block; width: 100%; height: auto; outline: 1px solid var(--edge); outline-offset: -1px; }
  .still { display: none; }
  /* <source media> is only read when a video loads, so each mode gets its own video and CSS shows one;
     a muted autoplaying video that's hidden waits and starts when it's shown. */
  @media (prefers-color-scheme: dark) { video.for-light { display: none; } }
  @media (prefers-color-scheme: light) { video.for-dark { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .motion { display: none; }
    .still { display: block; }
  }
  .head .icon.mac { width: 70px; height: 70px; margin: -7px; }
  .head .icon.mac img, .head img.icon.mac { width: 70px; height: 70px; border-radius: 0; }
  .note { width: min(100% - 48px, 600px); margin: 64px auto 0; padding-bottom: 120px; color: var(--muted); font-size: 13px; }

  @media (max-width: 680px) {
    .head h1 { font-size: 28px; }
    .shots { gap: 72px; padding-top: 64px; }
    .shots figcaption { font-size: 19px; }
    .shots figure.phone, .shots figure.phone:nth-of-type(even) { grid-template-columns: 1fr; grid-template-areas: "words" "screen"; justify-items: start; }
    .shots figure.phone > :not(figcaption) { width: 78vw; max-width: 300px; }
    .screen img { border-radius: min(10.5vw, 40px); }
  }
</style>
