---
import portrait from "../assets/portrait.webp";
import { Image } from "astro:assets";
import { article, contact, earlier, intro, looks, next, work } from "./content";

interface Props {
  look: string;
  font: string;
}
const { look, font } = Astro.props;
---

<!doctype html>
<html lang="en" data-look={look}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex" />
    <title>{intro.name} · look: {look}</title>
    <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.png" />
    <slot name="head" />
  </head>
  <body>
    <main class="page">
      <header class="intro">
        <Image src={portrait} alt="Emmanuel Chucks" width={128} height={128} class="portrait" />
        <h1>{intro.name}</h1>
        <p class="opening">
          <span class="stand-in">Your opening, in your words, goes here.</span>
          {intro.line}
        </p>
        <p class="place">{intro.place}</p>
        <ul class="contact">
          {contact.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
        </ul>
      </header>

      <section class="work" aria-labelledby="work-h">
        <h2 id="work-h">Work</h2>
        <ol>
          {
            work.map((w, i) => (
              <li class:list={["item", `item-${i + 1}`, w.media && `media-${w.media}`]}>
                <div class="text">
                  <span class="n">{String(i + 1).padStart(2, "0")}</span>
                  <h3>{w.title}</h3>
                  <p class="kind">{w.kind}</p>
                  <p>{w.text}</p>
                </div>
                {w.media && (
                  <div class="frame" role="img" aria-label={w.mediaLabel}>
                    <span>{w.mediaLabel}</span>
                  </div>
                )}
              </li>
            ))
          }
        </ol>
        <p class="next">{next}</p>
      </section>

      <section class="writing" aria-labelledby="writing-h">
        <h2 id="writing-h">Writing</h2>
        <a class="post" href="#">
          <span class="post-title">{article.title}</span>
          <span class="post-text">{article.text}</span>
        </a>
      </section>

      <section class="earlier" aria-labelledby="earlier-h">
        <h2 id="earlier-h">Earlier</h2>
        <ul>
          {earlier.map((e) => <li><a href={e.href}>{e.title}</a> <span>{e.text}</span></li>)}
        </ul>
      </section>

      <footer class="looks">
        <p>Look: <strong>{look}</strong>. Others:</p>
        <ul>
          {looks.filter((l) => l.slug !== look).map((l) => <li><a href={`/looks/${l.slug}`}>{l.name}</a></li>)}
        </ul>
      </footer>
    </main>
  </body>
</html>
