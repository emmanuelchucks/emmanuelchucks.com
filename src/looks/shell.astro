---
import { concepts, grain, intro } from "./content";

interface Props {
  slug: string;
  font: string;
  family: string;
  axes: string;
}
const { slug, font, family, axes } = Astro.props;
const fontFace = `@font-face{font-family:"${family}";src:url(${font}) format("woff2");${axes}font-display:swap}:root{--grain:${grain}}`;
---

<!doctype html>
<html lang="en" data-concept={slug}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex" />
    <title>{intro.name}</title>
    <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.png" />
    <style is:inline set:html={fontFace} />
  </head>
  <body>
    <slot />
    <nav class="concepts" aria-label="Concepts">
      {
        concepts.map((c, i) => (
          <a href={`/looks/${c.slug}`} aria-current={c.slug === slug ? "page" : undefined}>
            {i + 1}. {c.name}
          </a>
        ))
      }
    </nav>
  </body>
</html>

<style is:global>
  .concepts {
    position: fixed; inset: auto 0 0 0; z-index: 50; display: flex; gap: 0.25rem; overflow-x: auto;
    padding: 0.5rem; font: 500 12px/1 system-ui, sans-serif; background: #111d; backdrop-filter: blur(8px);
  }
  .concepts a { flex: none; color: #ccc; text-decoration: none; padding: 0.5rem 0.65rem; border-radius: 0.35rem; }
  .concepts a[aria-current] { background: #fff; color: #111; }
  body { padding-bottom: 3rem; }
</style>
